#!/usr/bin/bash
# SageOS flatpak setup: installs/updates the refs in /usr/share/sageos/flatpaks.list.
#
# Runs as a oneshot service on boot, but only does work when the list file's
# hash differs from the last successfully applied one — so a changed list in a
# new image update is picked up automatically, and normal boots cost one
# sha256sum. Independent of (and ordered after) bazzite-flatpak-manager.

set -uo pipefail

LIST="/usr/share/sageos/flatpaks.list"
VER_FILE="/etc/sageos/flatpak_setup_version"
VER="$(sha256sum "${LIST}" | cut -d' ' -f1)"

if [[ -f "${VER_FILE}" && "$(cat "${VER_FILE}")" == "${VER}" ]]; then
    echo "SageOS flatpak setup already applied for this list (${VER:0:12}). Exiting."
    exit 0
fi

# Ensure Flathub exists and is enabled (idempotent; normally done by Bazzite)
flatpak remote-add --if-not-exists --system flathub /etc/flatpak/remotes.d/flathub.flatpakrepo || :
flatpak remote-modify --system --enable flathub || :

failed=0
while read -r ref; do
    echo "Installing: ${ref}"
    if ! flatpak install --system --noninteractive --or-update flathub "${ref}"; then
        echo "FAILED: ${ref}" >&2
        failed=1
    fi
done < <(grep -vE '^\s*(#|$)' "${LIST}")

if [[ "${failed}" -eq 0 ]]; then
    mkdir -p /etc/sageos
    echo "${VER}" > "${VER_FILE}"
    echo "SageOS flatpak setup complete (${VER:0:12})."
fi

# Non-zero exit lets Restart=on-failure retry (e.g. network not up yet)
exit "${failed}"
