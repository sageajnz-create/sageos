#!/usr/bin/bash
# sageos-doctor — automated health check for a SageOS install.
# Machine-checkable subset of docs/phase*-validation.md. Run via
# `ujust sageos-doctor` (or directly). Exit 0 = no failures (warnings OK).
#
# WARN vs FAIL: things that are expected to differ in a VM or before first
# network-connected boot are warnings, so the doctor is useful everywhere.

set -uo pipefail

json_mode=false
case "${1:-}" in
    --json) json_mode=true ;;
    "") ;;
    *) echo "Usage: sageos-doctor [--json]" >&2; exit 2 ;;
esac

result_file=""
current_section=""
if "${json_mode}"; then
    result_file="$(mktemp)" || exit 1
    trap 'rm -f "${result_file}"' EXIT
fi

pass=0 fail=0 warn=0

record() {
    local status="$1" message="$2"
    if "${json_mode}"; then
        printf '%s\t%s\t%s\n' "${status}" "${current_section}" "${message}" >> "${result_file}"
    else
        case "${status}" in
            pass) printf '  \033[32mPASS\033[0m  %s\n' "${message}" ;;
            fail) printf '  \033[31mFAIL\033[0m  %s\n' "${message}" ;;
            warn) printf '  \033[33mWARN\033[0m  %s\n' "${message}" ;;
        esac
    fi
}

ok()   { record pass "$1"; pass=$((pass+1)); }
bad()  { record fail "$1"; fail=$((fail+1)); }
note() { record warn "$1"; warn=$((warn+1)); }

section() {
    current_section="$1"
    "${json_mode}" || printf '\n\033[1m-- %s --\033[0m\n' "$1"
}

"${json_mode}" || echo "== SageOS doctor =="

section "Image identity"
if grep -qs "NAME=SageOS" /etc/sageos-release; then
    ok "/etc/sageos-release present"
else
    bad "/etc/sageos-release missing — not a SageOS image?"
fi
booted="$(rpm-ostree status --booted 2>/dev/null || true)"
if grep -qi "sageos" <<<"${booted}"; then
    ok "booted deployment is a SageOS image"
elif [[ -n "${booted}" ]]; then
    note "booted deployment is not SageOS (stock base? pre-rebase?)"
else
    note "rpm-ostree status unavailable (container/chroot?)"
fi

section "Graphics"
if command -v vulkaninfo >/dev/null; then
    vk="$(vulkaninfo --summary 2>/dev/null || true)"
    if grep -qi "radv" <<<"${vk}"; then
        ok "Vulkan: RADV active"
    elif grep -qi "llvmpipe" <<<"${vk}"; then
        note "Vulkan: llvmpipe software renderer (VM or driver problem)"
    else
        note "Vulkan: no RADV device reported"
    fi
else
    bad "vulkaninfo not installed (should be layered in image)"
fi
if command -v glxinfo >/dev/null; then
    gl="$(glxinfo -B 2>/dev/null || true)"
    if grep -qi "radeonsi" <<<"${gl}"; then
        ok "OpenGL: radeonsi active"
    elif grep -qi "llvmpipe" <<<"${gl}"; then
        note "OpenGL: llvmpipe software renderer (VM or driver problem)"
    else
        note "OpenGL: renderer not radeonsi (no display session?)"
    fi
else
    bad "glxinfo not installed (should be layered in image)"
fi
if command -v vainfo >/dev/null; then
    if vainfo 2>/dev/null | grep -q "VAEntrypoint"; then
        ok "VA-API: decode entrypoints present"
    else
        note "VA-API: no entrypoints (VM, or missing display session)"
    fi
else
    bad "vainfo not installed (should be layered in image)"
fi
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
    ok "session is Wayland"
elif [[ -n "${XDG_SESSION_TYPE:-}" ]]; then
    note "session is ${XDG_SESSION_TYPE}, expected wayland"
else
    note "no graphical session detected (running from tty/ssh?)"
fi

section "Audio"
if command -v wpctl >/dev/null && wpctl status &>/dev/null; then
    if wpctl status 2>/dev/null | grep -qE "^\s*\*"; then
        ok "PipeWire: graph up, default device set"
    else
        note "PipeWire: running but no default device marked"
    fi
else
    note "PipeWire/wpctl not reachable (no user session?)"
fi

section "Gaming stack"
command -v steam     >/dev/null && ok "Steam present (native)"      || bad "Steam missing from image"
command -v gamemoded >/dev/null && ok "GameMode present (native)"   || bad "GameMode missing from image"
command -v gamescope >/dev/null && ok "gamescope present (native)"  || note "gamescope not found"
command -v mangohud  >/dev/null && ok "MangoHud present"            || note "MangoHud CLI not in PATH (flatpak layer may still work)"

section "Flatpaks"
if flatpak remotes --system 2>/dev/null | grep -q flathub; then
    ok "Flathub remote configured"
else
    bad "Flathub remote missing"
fi
if systemctl is-enabled sageos-flatpak-setup.service &>/dev/null; then
    ok "sageos-flatpak-setup enabled"
else
    bad "sageos-flatpak-setup not enabled"
fi
if [[ -f /etc/sageos/flatpak_setup_version ]]; then
    ok "sageos flatpak list applied ($(cut -c1-12 /etc/sageos/flatpak_setup_version))"
else
    note "sageos flatpak list not yet applied (first boot pending / no network yet)"
fi
for app in com.heroicgameslauncher.hgl net.lutris.Lutris com.usebottles.bottles org.libreoffice.LibreOffice; do
    if flatpak info --system "${app}" &>/dev/null; then
        ok "flatpak: ${app}"
    else
        note "flatpak not installed yet: ${app}"
    fi
done

section "Services"
systemctl is-enabled podman.socket &>/dev/null && ok "podman.socket enabled" || bad "podman.socket not enabled"

section "Updates & integrity"
command -v uupd >/dev/null && ok "uupd present" || bad "uupd missing (updates would not run)"
systemctl is-enabled uupd.timer &>/dev/null && ok "automatic updates armed (uupd.timer)" || bad "uupd.timer not enabled"
if [[ -f /etc/rpm-ostreed.conf ]] && grep -q "AutomaticUpdatePolicy=none" /etc/rpm-ostreed.conf; then
    ok "rpm-ostree auto policy none (uupd owns updates, no double-update)"
else
    note "rpm-ostreed.conf not set to none — possible double-update path"
fi
POLICY="/etc/containers/policy.json"
KEY="/etc/pki/containers/cosign.pub"
IMAGE_REF="ghcr.io/sageajnz-create/sageos"
if [[ -f "${POLICY}" && -f "${KEY}" ]] \
    && grep -q "sigstoreSigned" "${POLICY}" \
    && grep -q "${IMAGE_REF}" "${POLICY}"; then
    ok "image signature enforced for ${IMAGE_REF}"
else
    bad "signature policy missing — updates are not verified as ours"
fi
if systemctl is-enabled sageos-pin.service &>/dev/null; then
    if rpm-ostree status --json >/dev/null 2>&1; then
        # rpm-ostree's JSON is too large for the environment (E2BIG on exec).
        status_file="$(mktemp)" || status_file=""
        pinned="unknown"
        if [[ -n "${status_file}" ]] && rpm-ostree status --json >"${status_file}" 2>/dev/null; then
            pinned="$(python3 - "${status_file}" <<'PYEOF'
import json, sys
try:
    deps = json.load(open(sys.argv[1], encoding="utf-8")).get("deployments") or []
except Exception:
    print("unknown"); raise SystemExit
booted = next((d for d in deps if d.get("booted")), None)
if booted is None:
    print("unknown")
elif "pinned" not in booted:
    print("no-field")  # older rpm-ostree: pin state not reported
else:
    print("pinned" if booted["pinned"] else "unpinned")
PYEOF
)"
        fi
        [[ -z "${status_file}" ]] || rm -f "${status_file}"
        case "${pinned}" in
            pinned)  ok "booted deployment pinned — rollback point guaranteed" ;;
            unpinned) note "booted deployment not yet pinned (sageos-pin runs at boot)" ;;
            no-field) note "rpm-ostree too old to report pin state" ;;
            *)       note "deployment state unreadable (container/chroot?)" ;;
        esac
    else
        note "rpm-ostree status unavailable (container/chroot?)"
    fi
else
    bad "sageos-pin.service not enabled — no guaranteed rollback point"
fi
systemctl is-enabled greenboot-healthcheck.service &>/dev/null \
    && ok "greenboot health checks enabled" \
    || note "greenboot not enabled (automatic rollback on failed boot unavailable)"

if "${json_mode}"; then
    python3 - "${result_file}" "${pass}" "${warn}" "${fail}" <<'PYEOF'
import json
import sys

path, passed, warnings, failed = sys.argv[1:]
checks = []
with open(path, encoding="utf-8") as results:
    for line in results:
        status, section, message = line.rstrip("\n").split("\t", 2)
        checks.append({"status": status, "section": section, "message": message})

print(json.dumps({
    "schema_version": 1,
    "healthy": int(failed) == 0,
    "summary": {
        "passed": int(passed),
        "warnings": int(warnings),
        "failed": int(failed),
    },
    "checks": checks,
}, indent=2))
PYEOF
else
    printf '\n\033[1m== Summary: %d passed, %d warnings, %d failed ==\033[0m\n' "${pass}" "${warn}" "${fail}"
fi
[[ "${fail}" -eq 0 ]]
