# SageOS image build parameters (consumed by Justfile and CI)

# Output image name → ghcr.io/<REPO_ORGANIZATION>/sageos
IMAGE_NAME=sageos

# CHANGEME: your GitHub username or org, lowercase
REPO_ORGANIZATION="CHANGEME"

IMAGE_DESC="SageOS — gaming-first, atomic daily-driver built on Bazzite"
IMAGE_KEYWORDS="bootc,ublue,bazzite,gaming,linux,amd"

# Shown on artifacthub.io if you list the image there (optional)
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"

DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
